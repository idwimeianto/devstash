# Copy to .env and fill in. Never commit real values.

# App
# Public base URL for email and Stripe links (inlined at build time). Empty locally uses http://localhost:3000.
NEXT_PUBLIC_APP_URL=

# Database (Neon PostgreSQL, pooled connection string)
DATABASE_URL=

# Auth.js (generate AUTH_SECRET with `npx auth secret`)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Email (Resend). RESEND_FROM must be on a verified domain, e.g. "DevStash <noreply@example.com>";
# empty falls back to Resend's shared sender, which only delivers to the Resend account owner.
RESEND_API_KEY=
RESEND_FROM=

# Set to false to skip email verification on register and sign-in (any other value keeps it on)
EMAIL_VERIFICATION_ENABLED=

# Rate limiting (Upstash Redis). Without these, auth limits are skipped and AI calls are refused in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2 storage (file and image uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Locally, from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=

# Pro gating: free-plan limits and Pro-only features apply unless this is exactly "false"
PRO_GATING_ENABLED=

# OpenAI (AI features)
OPENAI_API_KEY=

# Context7 MCP (development tooling only, not used by the app)
CONTEXT7_API_KEY=
